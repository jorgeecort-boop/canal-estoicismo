# =====================================================================
# canal-estoicismo — Environment Variables
# Copy this file to .env and fill in your values
# =====================================================================

# ── TTS Settings ──────────────────────────────────────────────────────
# Voice for Edge-TTS (free, no key needed)
TTS_VOICE=es-MX-JorgeNeural
TTS_PROVIDER=edge-tts
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_PITCH=+0Hz

# ── Image Generation ──────────────────────────────────────────────────
# Provider: pollinations (free, no key) | local_assets | dalle
IMAGE_PROVIDER=pollinations
IMAGE_WIDTH=1920
IMAGE_HEIGHT=1080

# ── Optional: ElevenLabs TTS (premium, needs API key) ─────────────────
# ELEVENLABS_API_KEY=your_key_here

# ── Optional: OpenAI DALL-E (needs API key) ────────────────────────────
# OPENAI_API_KEY=your_key_here

# ── Optional: Google Gemini for story generation (free key: https://aistudio.google.com/apikey) ──
# Either variable works; the code reads GOOGLE_API_KEY first.
# GOOGLE_API_KEY=your_key_here
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash

# ── Optional: OpenRouter for story generation (--llm openrouter) ──────────
# Key: https://openrouter.ai/keys | Model override: OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
# OPENROUTER_API_KEY=your_key_here

# ── Optional: NVIDIA NIM for story generation (--llm nvidia) ───────────────
# Key: https://build.nvidia.com | Model override: NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_API_KEY=your_key_here

# ── Narrative ─────────────────────────────────────────────────────────
DEFAULT_THEME=control_dichotomy
DEFAULT_SCENES=6
DEFAULT_DURATION_MIN=5.0

# ── Debug ─────────────────────────────────────────────────────────────
DEBUG=false
DRAFT_MODE=false
